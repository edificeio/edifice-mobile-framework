+    if (_isUpdatingContentSize) return;
+    if ([keyPath isEqualToString:@"contentSize"] && [object isKindOfClass:[UIScrollView class]]) {
+        UIScrollView *scrollView = (UIScrollView *)object;
+        if (_pdfView.scaleFactor <= _pdfView.minScaleFactor * 1.01) {
+            // Maintain horizontal scroll lock
+            CGSize currentSize = scrollView.contentSize;
+            if (currentSize.width != scrollView.bounds.size.width) {
+                _isUpdatingContentSize = YES;
+                currentSize.width = scrollView.bounds.size.width;
